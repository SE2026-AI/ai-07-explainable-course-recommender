# Bản mẫu cấu hình triển khai. Trên máy chủ: sao chép thành build/deploy/.env,
# điền giá trị thật, đặt quyền chỉ chủ sở hữu đọc được. KHÔNG commit file .env.
# Hướng dẫn: docs/setup.md

# Tài khoản PostgreSQL do compose tạo ra ở lần khởi động đầu tiên.
# Đổi mật khẩu ở đây sau khi volume pgdata đã tạo sẽ KHÔNG có tác dụng: tài khoản chỉ
# được tạo ở lần khởi động đầu tiên. Phải đổi bằng ALTER ROLE trong database.
POSTGRES_USER=ai07
POSTGRES_PASSWORD=
POSTGRES_DB=course_recommender

# Phiên bản gắn vào tên image, nên đặt theo tag hoặc commit đang triển khai.
APP_VERSION=latest

# Địa chỉ API lắng nghe trên máy chủ. Giữ 127.0.0.1 khi có reverse proxy phía trước.
API_BIND=127.0.0.1:8000

TZ=Asia/Ho_Chi_Minh
